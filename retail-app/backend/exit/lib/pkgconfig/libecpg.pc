prefix=/home/gleb/smart-retail-project/retail-app/backend/exit
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libecpg
Description: PostgreSQL libecpg library
URL: https://www.postgresql.org/
Version: 17.6
Requires: 
Requires.private: libpq, libpgtypes
Cflags: -I${includedir}
Libs: -L${libdir} -lecpg
Libs.private: -L/home/gleb/smart-retail-project/retail-app/backend/exit/lib -lpgcommon -lpgport -lpq -lm
