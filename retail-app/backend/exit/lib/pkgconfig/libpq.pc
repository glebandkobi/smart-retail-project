prefix=/home/gleb/smart-retail-project/retail-app/backend/exit
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libpq
Description: PostgreSQL libpq library
URL: https://www.postgresql.org/
Version: 17.6
Requires: 
Requires.private: libssl, libcrypto
Cflags: -I${includedir}
Libs: -L${libdir} -lpq
Libs.private: -L/home/gleb/smart-retail-project/retail-app/backend/exit/lib -lpgcommon -lpgport -lssl -lgssapi_krb5 -lm -lldap
